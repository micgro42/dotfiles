# The following part is from http://www.splitbrain.org/blog/2008-02/27-keeping_your_home_directory_organized :
export TD="$HOME/temp/`date +'%Y-%m-%d'`"
td(){
    td=$TD
    if [ ! -z "$1" ]; then
        td="$HOME/temp/`date -d "$1 days" +'%Y-%m-%d'`";
    else
        ln -s -f -T $td "$HOME/temp/00-today"
    fi
    mkdir -p $td; cd $td
    unset td
}

